# ===== 明道云 HAP（个人访问令牌：头像 → 授权与访问 → 添加） =====
MINGDAO_PAT=
# MCP 通道（官方 SaaS 默认地址）
MINGDAO_MCP_URL=https://api.mingdao.com/mcp

# 目标应用（自动建库脚本默认写入）
MD_APP_ID=
# 6 张工作表 ID（运行 node scripts/seed-mingdao.mjs 自动写入）
MD_WS_ROLE=
MD_WS_TASK=
MD_WS_WORKTOOL=
MD_WS_QUIZ=
MD_WS_MEMBER=
MD_WS_TUTORIAL=

# ===== 智谱 AI（OpenAI 兼容；key 从 https://open.bigmodel.cn 控制台获取） =====
AI_API_BASE=https://open.bigmodel.cn/api/paas/v4
AI_API_KEY=
AI_MODEL=glm-4-flash
AI_VISION_MODEL=glm-4v-flash

# 服务端口
PORT=8787
