# ===== 明道云 HAP（应用的授权管理 → 新建授权密钥） =====
MINGDAO_APP_KEY=
MINGDAO_SIGN=
# 默认官方 SaaS，无需改
MINGDAO_API_BASE=https://api.mingdao.com

# ===== 6 张工作表（应用内 API 开发文档可查） =====
# worksheetId = 工作表 ID；MD_VIEW_* = 该表任一视图的视图 ID（查询用）
MD_WS_ROLE=
MD_VIEW_ROLE=
MD_WS_TASK=
MD_VIEW_TASK=
MD_WS_WORKTOOL=
MD_VIEW_WORKTOOL=
MD_WS_QUIZ=
MD_VIEW_QUIZ=
MD_WS_MEMBER=
MD_VIEW_MEMBER=
MD_WS_TUTORIAL=
MD_VIEW_TUTORIAL=

# ===== 智谱 AI（OpenAI 兼容；key 从 https://open.bigmodel.cn 控制台获取） =====
AI_API_BASE=https://open.bigmodel.cn/api/paas/v4
AI_API_KEY=
AI_MODEL=glm-4-flash
AI_VISION_MODEL=glm-4v-flash

# 服务端口
PORT=8787
